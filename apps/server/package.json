{
  "name": "server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts --dev",
    "build": "esbuild src/main.ts --bundle --platform=node --format=cjs --target=node22 --outfile=out/main.cjs",
    "check-types": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@OpenAde/connector-cmd": "workspace:*",
    "@OpenAde/connector-sdk": "workspace:*",
    "@OpenAde/contracts": "workspace:*",
    "@OpenAde/shared": "workspace:*",
    "@effect/platform-node": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@OpenAde/client-runtime": "workspace:*",
    "@OpenAde/config": "workspace:*",
    "@OpenAde/testkit": "workspace:*",
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "esbuild": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
