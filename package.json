{
  "name": "OpenAde",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo run dev:hmr -F desktop --",
    "build": "turbo run build --filter='!desktop' && turbo run build -F desktop",
    "check-types": "turbo run check-types",
    "dev:web": "turbo run dev -F web --",
    "dev:desktop": "turbo run dev:hmr -F desktop --",
    "build:desktop": "turbo run build:stable -F desktop --",
    "build:desktop:canary": "turbo run build:canary -F desktop --",
    "check": "oxlint && oxfmt --write"
  },
  "devDependencies": {
    "@OpenAde/config": "workspace:*",
    "@types/node": "catalog:",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "turbo": "^2.10.7",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@11.21.0"
}
