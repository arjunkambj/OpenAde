{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "rules": {
    "types": "off",
    "nsTypes": "off"
  },
  "tags": ["-@public"],
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs"],
      "project": ["scripts/*.mjs"]
    },
    "apps/desktop": {
      "entry": [
        "src/main/index.ts!",
        "src/preload/index.ts!",
        "electron-builder.config.cjs",
        "scripts/*.mjs"
      ],
      // tsx is resolved through the server package (it is a server devDep).
      "ignoreDependencies": ["@OpenAde/contracts", "@OpenAde/shared", "tsx"]
    },
    "apps/server": {
      "ignoreExportsUsedInFile": true
    },
    "apps/web": {
      "entry": ["src/routes/**/*.tsx"],
      "ignoreIssues": {
        "src/components/header.tsx": ["files"],
        "src/components/mode-toggle.tsx": ["files"],
        "src/hooks/use-mobile.ts": ["files"],
        "src/lib/icon.tsx": ["exports"],
        "src/lib/shortcuts.tsx": ["exports"]
      },
      "ignoreDependencies": [
        "@OpenAde/config",
        "@iconify-json/solar",
        "clsx",
        "postcss",
        "tailwind-merge",
        "tailwindcss"
      ]
    },
    "packages/client-runtime": {
      "includeEntryExports": true,
      "ignoreExportsUsedInFile": true,
      "ignoreDependencies": ["@OpenAde/shared", "@effect/atom-react"]
    },
    "packages/connector-cmd": {
      "includeEntryExports": true,
      "ignoreExportsUsedInFile": true,
      // Spawned via execFileSync — a system tool, not an npm dependency.
      "ignoreBinaries": ["pgrep"]
    },
    "packages/connector-sdk": {
      "includeEntryExports": true,
      "ignoreExportsUsedInFile": true
    },
    "packages/contracts": {
      "includeEntryExports": true,
      "ignoreExportsUsedInFile": true,
      "ignoreIssues": {
        "src/ids.ts": ["exports"]
      }
    },
    "packages/shared": {
      "includeEntryExports": true,
      "ignoreExportsUsedInFile": true
    },
    "packages/testkit": {
      "includeEntryExports": true,
      "ignoreExportsUsedInFile": true
    }
  }
}
