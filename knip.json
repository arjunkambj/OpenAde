{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "rules": {
    "types": "off",
    "nsTypes": "off"
  },
  "tags": ["-@public"],
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs"],
      "project": ["scripts/*.mjs"]
    },
    "apps/desktop": {
      "entry": [
        "src/main/index.ts!",
        "src/preload/index.ts!",
        "electron-builder.config.cjs",
        "scripts/*.mjs"
      ],
      "ignoreDependencies": ["@OpenAde/contracts", "@OpenAde/shared"]
    },
    "apps/server": {
      "ignoreDependencies": [
        "@OpenAde/connector-cmd",
        "@OpenAde/connector-sdk",
        "@OpenAde/contracts",
        "@OpenAde/testkit",
        "@effect/platform-node"
      ]
    },
    "apps/web": {
      "entry": ["src/routes/**/*.tsx"],
      "ignoreIssues": {
        "src/components/header.tsx": ["files"],
        "src/components/mode-toggle.tsx": ["files"],
        "src/hooks/use-mobile.ts": ["files"],
        "src/lib/icon.tsx": ["exports"],
        "src/lib/shortcuts.tsx": ["exports"]
      },
      "ignoreDependencies": [
        "@OpenAde/client-runtime",
        "@OpenAde/config",
        "@OpenAde/contracts",
        "@OpenAde/shared",
        "@effect/atom-react",
        "@iconify-json/solar",
        "@legendapp/list",
        "@pierre/diffs",
        "clsx",
        "effect",
        "postcss",
        "react-markdown",
        "remark-gfm",
        "sonner",
        "tailwind-merge",
        "tailwindcss"
      ]
    },
    "packages/client-runtime": {
      "includeEntryExports": true,
      "ignoreExportsUsedInFile": true,
      "ignoreDependencies": ["@OpenAde/contracts", "@OpenAde/shared", "@effect/atom-react"]
    },
    "packages/connector-cmd": {
      "includeEntryExports": true,
      "ignoreExportsUsedInFile": true,
      "ignoreDependencies": ["@OpenAde/connector-sdk", "@OpenAde/contracts", "@OpenAde/shared"]
    },
    "packages/connector-sdk": {
      "includeEntryExports": true,
      "ignoreExportsUsedInFile": true
    },
    "packages/contracts": {
      "includeEntryExports": true,
      "ignoreExportsUsedInFile": true,
      "ignoreIssues": {
        "src/ids.ts": ["exports"]
      }
    },
    "packages/shared": {
      "includeEntryExports": true,
      "ignoreExportsUsedInFile": true
    },
    "packages/testkit": {
      "includeEntryExports": true,
      "ignoreExportsUsedInFile": true
    }
  }
}