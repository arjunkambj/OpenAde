{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", "out/**", "artifacts/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    // apps/web type-checks through `vite build`, which is also the only thing
    // that writes the gitignored src/routeTree.gen.ts. Declaring it as this
    // task's output means a replay from cache puts it back: root-level `knip`
    // is not a turbo task, so without it a warm cache over a tree that has
    // never built leaves the import unresolved and fails a green gate.
    "web#check-types": {
      "dependsOn": ["^check-types"],
      "outputs": ["src/routeTree.gen.ts"]
    },
    "test": {
      "dependsOn": ["^test"],
      "inputs": ["$TURBO_DEFAULT$", "!README.md"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "dev:hmr": {
      "cache": false,
      "persistent": true
    },
    "build:stable": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["out/**", "artifacts/**"]
    },
    "build:canary": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["out/**", "artifacts/**"]
    }
  }
}
